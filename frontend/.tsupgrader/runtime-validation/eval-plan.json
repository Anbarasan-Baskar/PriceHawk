{
  "projectType": "webapp",
  "devServer": {
    "command": "npm",
    "args": ["start", "--", "--host", "127.0.0.1"],
    "url": "http://127.0.0.1:4200/",
    "readyTimeoutSeconds": 120
  },
  "setup": [
    {
      "command": "npm",
      "args": ["ci"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "angular-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "dashboard-home-responds",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["start", "--", "--host", "127.0.0.1"],
      "url": "http://127.0.0.1:4200/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test", "--", "--watch=false"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    }
  ]
}
